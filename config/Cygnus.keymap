#define ZMK_POINTING_DEFAULT_SCRL_VAL 120    // default: 10

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/*
#define MOUSE 4
#define SCROLL 5
#define NUM-FUNC 6
#define PRECISION 7
*/
/*
&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};
*/

/ {
    combos {
        compatible = "zmk,combos";

        double_quotation {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <20 21>;
        };

        // 右手小指最下段(33)と一番右下(42)の同時押しで精密モード(PRECISION, layer7)。
        // レイヤーに関係なくどこからでも効くようコンボにしている(MOUSEレイヤー内の単独キーだと、
        // まだAML未発動のうちに押すと下敷きのレイヤーのキーとして解釈され、レイヤーが有効にならなかったため)。

        precision_mode {
            bindings = <&mo 7>;
            key-positions = <33 42>;
            timeout-ms = <40>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        my_mt: my_mt {
            compatible = "zmk,behavior-hold-tap";
            label = "MY_MOD_TAP";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>; // 必要に応じて調整してください
            quick-tap-ms = <0>;
            bindings = <&kp>, <&kp>;
        };

        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        rotate: rotate {
            compatible = "zmk,behavior-sensor-rotate-var";
            label = "rotate";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q                &kp W    &kp E                     &kp R       &kp T                                       &kp Y        &kp U  &kp I      &kp O    &kp P
&kp A                &kp S    &kp D                     &kp F       &kp G        &mkp RCLK       &kp MINUS      &kp H        &kp J  &kp K      &lt 4 L  &lt 5 LS(MINUS)
&my_mt LEFT_SHIFT Z  &kp X    &kp C                     &kp V       &kp B        &mkp LCLK       &kp INT3       &kp N        &kp M  &kp COMMA  &kp DOT  &my_mt LEFT_SHIFT SLASH
&my_mt LCTRL ESCAPE  &kp TAB  &my_mt LEFT_ALT LEFT_WIN  &lt 6 INT5  &lt 3 SPACE  &lt 1 INT4      &kp BACKSPACE  &lt 2 ENTER                             &my_mt RALT DEL
            >;

            sensor-bindings = <&rotate SCRL_DOWN SCRL_UP>;
        };

        SIMBOL-SHTCT {
            bindings = <
&trans     &trans     &kp LS(NUMBER_7)  &kp LS(NUMBER_6)  &trans                            &kp EXCLAMATION    &kp QUESTION  &kp LS(N8)          &kp LS(N9)             &kp RS(PIPE)
&kp LC(A)  &kp LC(S)  &kp LC(X)         &kp LC(C)         &kp LC(V)  &trans      &kp COLON  &kp LS(SQT)        &kp AT_SIGN   &kp LS(AT_SIGN)     &kp LEFT_BRACKET       &kp LS(N3)
&kp LC(Z)  &trans     &kp LC(LS(SEMI))  &kp LS(SEMI)      &trans     &trans      &kp SEMI   &kp LS(SEMICOLON)  &kp QUESTION  &kp LS(LEFT_BRACE)  &kp LS(RIGHT_BRACKET)  &kp LS(N4)
&trans     &trans     &trans            &trans            &trans     &trans      &trans     &trans                                                                      &kp LS(N5)
            >;
        };

        NUM-FUNC {
            bindings = <
&kp F1   &kp F2  &kp F3  &kp F4  &kp F5                                    &kp PRINTSCREEN  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp MINUS
&kp F6   &kp F7  &kp F8  &kp F9  &kp F10  &trans      &kp LC(PRINTSCREEN)  &kp EQUAL        &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp PLUS
&kp F11  &trans  &trans  &trans  &trans   &trans      &kp DOT              &kp NUMBER_0     &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp ASTERISK
&kp F12  &trans  &trans  &trans  &trans   &trans      &trans               &trans                                                     &kp SLASH
            >;
        };

        ARROW {
            bindings = <
&kp ESCAPE      &kp LC(LS(TAB))         &kp UP_ARROW    &kp LC(TAB)              &trans                       &trans  &trans            &mmv MOVE_UP      &trans           &trans
&kp HOME        &kp LEFT_ARROW          &kp DOWN_ARROW  &kp RIGHT_ARROW          &kp END  &trans      &trans  &trans  &mmv MOVE_LEFT    &mmv MOVE_DOWN    &mmv MOVE_RIGHT  &trans
&kp LEFT_SHIFT  &kp LG(LS(LEFT_ARROW))  &trans          &kp LG(LS(RIGHT_ARROW))  &trans   &trans      &trans  &trans  &mmv MOVE_X(200)  &mmv MOVE_Y(200)  &trans           &trans
&trans          &trans                  &trans          &trans                   &trans   &trans      &trans  &trans                                                       &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        MOUSE {
            bindings = <
&trans       &trans       &kp LC(PAGE_UP)  &kp LC(PAGE_DOWN)  &kp LC(W)                         &kp LC(W)  &kp LC(PAGE_UP)  &kp LC(PAGE_DOWN)  &trans       &trans
&lt 5 SPACE  &lt 4 SPACE  &mkp LCLK        &mkp RCLK          &mkp MCLK  &mkp RCLK      &trans  &mkp MCLK  &mkp LCLK        &mkp RCLK          &lt 4 SPACE  &lt 5 SPACE
&trans       &trans       &trans           &trans             &trans     &mkp LCLK      &trans  &trans     &mkp MB4         &mkp MB5           &trans       &trans
&trans       &trans       &trans           &trans             &trans     &trans         &trans  &trans                                                      &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&none   &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans        &trans        &trans        &trans                                 &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans        &trans        &trans        &trans     &trans      &studio_unlock  &trans        &trans        &trans        &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kt KP_N4  &trans      &bootloader     &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans        &trans        &trans        &trans     &trans      &trans          &trans                                                  &bt BT_CLR_ALL
            >;
        };

        // 精密モード: 全キーtransparent。MOUSEレイヤー内の&mo 7を押している間だけ有効になり、
        // snipe-layers = <7>(Cygnus_R.overlay)でトラックボールのCPIを1/4に落とす。

        PRECISION {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };
    };
};
