#define ZMK_POINTING_DEFAULT_SCRL_VAL 120    // default: 10

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/*
#define MOUSE 4
#define SCROLL 5
#define NUM-FUNC 6
#define PRECISION 7
*/

&mt {
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";

        double_quotation {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <20 21>;
        };

        // 同時押しで精密モード(PRECISION, layer7)。
        // レイヤーに関係なくどこからでも効くようコンボにしている(MOUSEレイヤー内の単独キーだと、
        // まだAML未発動のうちに押すと下敷きのレイヤーのキーとして解釈され、レイヤーが有効にならなかったため)。

        precision_mode {
            bindings = <&mo 7>;
            key-positions = <33 21>;
            timeout-ms = <40>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        rotate: rotate {
            compatible = "zmk,behavior-sensor-rotate-var";
            label = "rotate";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp W    &kp E                  &kp R       &kp T                                                 &kp Y        &kp U  &kp I      &lt 4 O  &lt 5 P
&kp A             &kp S    &kp D                  &kp F       &kp G        &mkp RCLK       &kp LS(INTERNATIONAL_1)  &kp H        &kp J  &kp K      &kp L    &kp MINUS
&mt LEFT_SHIFT Z  &kp X    &kp C                  &kp V       &kp B        &mkp LCLK       &kp INT3                 &kp N        &kp M  &kp COMMA  &kp DOT  &mt LEFT_SHIFT SLASH
&mt LCTRL ESCAPE  &kp TAB  &mt LEFT_ALT LEFT_WIN  &lt 6 INT5  &lt 3 SPACE  &lt 1 INT4      &kp BACKSPACE            &lt 2 ENTER                             &mt RALT DEL
            >;

            sensor-bindings = <&rotate SCRL_DOWN SCRL_UP>;
        };

        SIMBOL-SHTCT {
            bindings = <
&none      &none      &kp EQUAL             &kp LS(EQUAL)  &kp LC(PRINTSCREEN)                          &kp LS(N1)  &kp LS(FSLH)  &kp LS(N8)    &kp LS(N9)    &kp LS(BACKSLASH)
&kp LC(A)  &kp LC(S)  &kp LC(SINGLE_QUOTE)  &kp LC(SEMI)   &kp PRINTSCREEN      &trans      &kp LS(N7)  &kp LS(N2)  &kp LS(N6)    &kp RBKT      &kp NUHS      &kp LS(N3)
&kp LC(Z)  &kp LC(X)  &kp LC(C)             &kp LC(V)      &none                &trans      &kp SEMI    &kp SQT     &kp LBKT      &kp LS(RBKT)  &kp LS(NUHS)  &kp LS(N4)
&trans     &trans     &trans                &trans         &trans               &trans      &trans      &trans                                                &kp LS(N5)
            >;
        };

        NUM-FUNC {
            bindings = <
&kp F1  &kp F2   &kp F3   &kp F4  &kp F5                        &none          &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp KP_MULTIPLY
&kp F6  &kp F7   &kp F8   &kp F9  &kp F10  &trans      &none    &kp LS(MINUS)  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp KP_DIVIDE
&trans  &kp F11  &kp F12  &none   &none    &trans      &kp DOT  &kp NUMBER_0   &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp KP_PLUS
&trans  &trans   &trans   &trans  &trans   &trans      &trans   &trans                                                   &kp KP_MINUS
            >;
        };

        ARROW {
            bindings = <
&kp ESCAPE      &kp LC(LS(TAB))         &kp UP_ARROW    &kp LC(TAB)              &trans                       &trans  &trans            &mmv MOVE_UP      &trans           &trans
&kp HOME        &kp LEFT_ARROW          &kp DOWN_ARROW  &kp RIGHT_ARROW          &kp END  &trans      &trans  &trans  &mmv MOVE_LEFT    &mmv MOVE_DOWN    &mmv MOVE_RIGHT  &trans
&kp LEFT_SHIFT  &kp LG(LS(LEFT_ARROW))  &trans          &kp LG(LS(RIGHT_ARROW))  &trans   &trans      &trans  &trans  &mmv MOVE_X(200)  &mmv MOVE_Y(200)  &trans           &trans
&trans          &trans                  &trans          &trans                   &trans   &trans      &trans  &trans                                                       &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        MOUSE {
            bindings = <
&lt 5 SPACE  &lt 4 SPACE  &kp LC(PAGE_UP)  &kp LC(PAGE_DOWN)  &none                             &none      &kp LC(PAGE_UP)  &kp LC(PAGE_DOWN)  &lt 4 SPACE  &lt 5 SPACE
&none        &none        &mkp LCLK        &mkp RCLK          &mkp MCLK  &mkp RCLK      &none   &mkp MCLK  &mkp LCLK        &mkp RCLK          &none        &none
&none        &none        &none            &none              &none      &mkp LCLK      &none   &none      &mkp MB4         &mkp MB5           &none        &none
&trans       &trans       &trans           &trans             &trans     &trans         &trans  &trans                                                      &none
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&none   &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans        &trans        &trans        &trans                                 &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans        &trans        &trans        &trans     &trans      &studio_unlock  &trans        &trans        &trans        &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kt KP_N4  &trans      &bootloader     &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans        &trans        &trans        &trans     &trans      &trans          &trans                                                  &bt BT_CLR_ALL
            >;
        };

        // 精密モード: 全キーtransparent。MOUSEレイヤー内の&mo 7を押している間だけ有効になり、
        // snipe-layers = <7>(Cygnus_R.overlay)でトラックボールのCPIを1/4に落とす。

        PRECISION {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        layer_8 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };
    };
};
